# Preserve the scheme the browser actually used. When another proxy (Caddy,
# a load balancer) terminates TLS in front of this container, it sends
# X-Forwarded-Proto: https while $scheme here is only ever http — forwarding
# $scheme would tell the app the request was plain HTTP and its redirects
# would come back as http:// on an HTTPS page, which browsers block.
map $http_x_forwarded_proto $forwarded_scheme {
    default $scheme;
    "~."    $http_x_forwarded_proto;
}

server {
    listen 80;
    root /usr/share/nginx/html;

    # The web build emits index-web.html, not index.html; serving the default
    # made "/" a 404.
    index index-web.html;

    # nginx's default is 1 MB, which rejects ordinary PDF attachments with 413.
    client_max_body_size 100m;

    location /api/ {
        proxy_pass http://api:26866;
        proxy_http_version 1.1;

        # No credential is injected here on purpose. The proxy used to add the
        # API token to every request, which would make the sign-in page
        # pointless: anyone who could load this page would already be
        # authenticated. The browser authenticates with the session cookie it
        # gets from signing in; the API token stays for scripts that call the
        # API directly.

        # $http_host, not $host: $host drops the port, so FastAPI's
        # trailing-slash redirects came back as http://localhost/... and the
        # browser followed them to port 80, where nothing is listening.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_scheme;
        proxy_set_header Connection "";

        # Chat responses and connector probes stream as server-sent events.
        # Buffering would hold every token back until the response finished.
        proxy_buffering off;
        proxy_cache off;

        # An agent turn with several tool calls can run for minutes; the old
        # 120s cut long answers off mid-stream.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index-web.html;
    }
}
