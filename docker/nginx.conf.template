server {
    listen 80;
    root /usr/share/nginx/html;

    # The web build emits index-web.html, not index.html; serving the default
    # made "/" a 404.
    index index-web.html;

    # nginx's default is 1 MB, which rejects ordinary PDF attachments with 413.
    client_max_body_size 100m;

    location /api/ {
        proxy_pass http://api:26866;
        proxy_http_version 1.1;

        # The API has no user accounts, so it authenticates callers with a
        # shared secret. Injecting it here keeps it out of the browser: a page
        # on another origin can reach the API only through this proxy, and CORS
        # already blocks it from reading the response. Empty when
        # COWORK_API_TOKEN is unset, which leaves the check disabled.
        proxy_set_header X-Cowork-Token "${COWORK_API_TOKEN}";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";

        # Chat responses and connector probes stream as server-sent events.
        # Buffering would hold every token back until the response finished.
        proxy_buffering off;
        proxy_cache off;

        # An agent turn with several tool calls can run for minutes; the old
        # 120s cut long answers off mid-stream.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index-web.html;
    }
}
