AWS_REGION=us-east-1
LITELLM_MASTER_KEY=sk-change-to-a-long-random-secret
LITELLM_DATABASE_PASSWORD=change-to-a-long-random-password
LITELLM_MAX_MONTHLY_BUDGET=100
COWORK_PLANNING_MODEL=planning
COWORK_CODING_MODEL=coding

# Any standards-compliant OIDC provider works (Keycloak, Cognito, Auth0, etc.).
OIDC_ISSUER_URL=https://login.example.com/realms/cowork
OIDC_CLIENT_ID=cowork
OIDC_CLIENT_SECRET=change-me
# Generate 32 random bytes and encode them with URL-safe base64.
OIDC_COOKIE_SECRET=change-to-a-valid-cookie-secret

