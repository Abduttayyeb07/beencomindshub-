# Copy to .env and fill in. .env holds live AWS credentials — never commit it.
#
# Prefer short-lived credentials or an SSO profile over a long-lived access
# key. In a real deployment, use an IAM role instead (see deploy/aws/).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# Shared secret between Cowork and this gateway. Any long random string;
# must match COWORK_MANAGED_API_KEY in backend/core_api/.env.
LITELLM_MASTER_KEY=sk-change-to-a-long-random-secret
