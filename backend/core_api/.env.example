# Settings for running cowork-server from source (`npm run dev:web`).
# Copy to .env in this directory. The Docker setup does not use this file —
# it takes the same values from the root .env via docker-compose.yml.

# Route every model call through the local Bedrock gateway
# (deploy/local/docker-compose.yml), which is the only component holding AWS
# credentials.
COWORK_MANAGED_ENABLED=true
COWORK_MANAGED_BASE_URL=http://127.0.0.1:4000/v1
# Must equal LITELLM_MASTER_KEY in deploy/local/.env.
COWORK_MANAGED_API_KEY=
COWORK_MANAGED_PLANNING_MODEL=planning
COWORK_MANAGED_CODING_MODEL=coding

# Connectors offered under "Connect Apps and Data" (comma-separated ids).
# Remove the line to offer the full catalogue.
COWORK_ENABLED_CONNECTORS=slack,postgres,clickhouse,clickup,notion,redis
