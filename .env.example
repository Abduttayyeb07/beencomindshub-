# Settings for `docker compose up`. Copy to .env and fill in.
# .env holds live credentials and is gitignored — never commit it.

# AWS account with Bedrock model access. Prefer short-lived credentials; the
# models used are listed in deploy/local/litellm-config.yaml.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# Shared secret between the api and the model gateway. Any long random string,
# e.g.:  python -c "import secrets; print('sk-local-' + secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY=

# Sign-in ─────────────────────────────────────────────────────────────────────
# One shared login, set here — there is no signup and no user list. Leave the
# password empty and the app is open to anyone who can reach it.
# Use a long random password; this is the only thing between the internet and
# an agent that can run code:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
COWORK_AUTH_EMAIL=
COWORK_AUTH_PASSWORD=

# How long a sign-in lasts before the password is asked for again.
COWORK_SESSION_TTL_HOURS=168

# Send the session cookie over HTTPS only. Turn this on the moment the app is
# reachable over anything but localhost, or the session can be stolen in transit.
COWORK_COOKIE_SECURE=false

# Token for scripts that call the API directly, sent as the X-Cowork-Token
# header. Independent of the sign-in above; leave empty if unused. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
COWORK_API_TOKEN=

# Optional ────────────────────────────────────────────────────────────────────

# Port the UI is published on (localhost only).
# WEB_PORT=3000

# Connectors offered under "Connect Apps and Data" (comma-separated ids).
# COWORK_ENABLED_CONNECTORS=slack,postgres,clickhouse,clickup,notion,redis

# Fernet key for the connector vault. Unset, one is generated into the data
# volume. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ANTON_VAULT_KEY=
